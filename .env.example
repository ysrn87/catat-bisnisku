# Database
DATABASE_URL="postgresql://user:password@localhost:5432/catat_bisnisku"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Internal API secret — dipakai middleware untuk panggil /api/store/resolve
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET="ganti-dengan-random-string-panjang"

# Super admin secret — untuk upgrade/downgrade plan via API
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPER_ADMIN_SECRET="ganti-dengan-random-string-panjang"
# Midtrans — ambil dari dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"        # Server key (rahasia, hanya di server)
MIDTRANS_IS_PRODUCTION="false"                   # Ganti "true" saat live

# Midtrans client key — aman untuk di-expose ke browser
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"       # Harus sama dengan MIDTRANS_IS_PRODUCTION
# Upstash Redis — untuk rate limiting
# Daftar gratis di https://upstash.com → Create Database → REST API
# Kalau tidak diset, rate limiting dinonaktifkan (aman untuk development)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# Email (Nodemailer + Gmail) — untuk development
# 1. Aktifkan 2-Step Verification di Google Account
# 2. Buka: Google Account → Security → 2-Step Verification → App Passwords
# 3. Buat App Password untuk "Mail", salin 16 karakter ke bawah
GMAIL_USER="kamu@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Catatan: Untuk production, ganti implementasi di src/lib/email.ts ke Resend
# setelah kamu punya domain. Variabel di atas bisa dihapus, ganti dengan:
# RESEND_API_KEY="re_xxxx"
