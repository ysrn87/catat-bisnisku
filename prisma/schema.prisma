generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Primary identifier: email (required, unique)
// Phone: optional, hanya untuk kontak/profil
// emailVerified: false sampai user klik link verifikasi
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  phone         String?   @unique
  emailVerified Boolean   @default(false)
  photoUrl      String?
  birthday      DateTime?
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedStores        Store[]           @relation("StoreOwner")
  staffRecords       StoreStaff[]
  storeUsers         StoreUser[]
  linkedCustomers    Customer[]
  sentInvitations    StaffInvitation[] @relation("InvitedBy")
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL VERIFICATION
// Token satu kali pakai untuk verifikasi email.
// newEmail = null   → verifikasi awal saat registrasi (set emailVerified=true)
// newEmail = terisi → konfirmasi ganti email (set email=newEmail saat diklik)
// ─────────────────────────────────────────────────────────────────────────────

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// PASSWORD RESET
// Token satu kali pakai untuk "lupa password" via email.
// Sengaja tabel terpisah dari EmailVerification (bukan numpang field baru di
// sana) karena masa berlaku, alur redeem, dan implikasi keamanannya beda.
// ─────────────────────────────────────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id            String    @id @default(cuid())
  ownerId       String
  name          String
  slug          String    @unique
  logoUrl       String?
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner           User              @relation("StoreOwner", fields: [ownerId], references: [id])
  staffMembers    StoreStaff[]
  storeUsers      StoreUser[]
  customers       Customer[]
  products        Product[]
  variants        ProductVariant[]
  categories      Category[]
  sales           Sale[]
  cashflows       Cashflow[]
  stockMovements  StockMovement[]
  settings        StoreSetting[]
  payments        Payment[]
  upgradePayments UpgradePayment[]
  invitations     StaffInvitation[]

  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE STAFF
// Tim operasional: OWNER, ADMINISTRATOR, MANAGER, CASHIER
// Dibuat hanya setelah user menerima StaffInvitation (kecuali OWNER saat
// register toko — langsung dibuat tanpa invitation)
// ─────────────────────────────────────────────────────────────────────────────

model StoreStaff {
  id       String    @id @default(cuid())
  storeId  String
  userId   String
  role     StaffRole @default(CASHIER)
  joinedAt DateTime  @default(now())

  store        Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashierSales Sale[] @relation("CashierSales")

  @@unique([storeId, userId])
  @@map("store_staff")
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF INVITATION
// Owner/Admin kirim undangan via email ke calon staff.
// token: dipakai di link email untuk accept/decline.
// Kalau email belum terdaftar → user registrasi dulu lalu auto-redirect ke
// halaman accept menggunakan token yang sama.
// ─────────────────────────────────────────────────────────────────────────────

model StaffInvitation {
  id          String           @id @default(cuid())
  storeId     String
  email       String
  role        StaffRole
  status      InvitationStatus @default(PENDING)
  invitedById String
  token       String           @unique
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitedBy", fields: [invitedById], references: [id])

  // Satu undangan aktif per email per toko
  @@unique([storeId, email, status])
  @@index([email])
  @@index([token])
  @@map("staff_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE USER  (murni member loyalty)
// ─────────────────────────────────────────────────────────────────────────────

model StoreUser {
  id       String   @id @default(cuid())
  storeId  String
  userId   String
  points   Int      @default(0)
  joinedAt DateTime @default(now())

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointHistories PointHistory[]
  memberSales    Sale[]         @relation("MemberSales")

  @@unique([storeId, userId])
  @@map("store_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER  (walk-in / non-member lokal per toko)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String?
  address   String?
  userId    String?  // diisi setelah upgrade ke member

  createdAt DateTime @default(now())

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id])
  sales Sale[]

  @@index([storeId])
  @@index([userId])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  sku         String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@unique([storeId, sku])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT VARIANT
// ─────────────────────────────────────────────────────────────────────────────

model ProductVariant {
  id            String      @id @default(cuid())
  storeId       String
  productId     String
  name          String
  sku           String
  barcode       String?
  price         Decimal     @db.Decimal(10, 2)
  cost          Decimal     @db.Decimal(10, 2)
  type          ProductType @default(READY_STOCK)
  stock         Int         @default(0)
  lowStockAt    Int         @default(10)
  pointsPerUnit Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALE
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id           String   @id @default(cuid())
  storeId      String
  cashierId    String   // → StoreStaff.id
  customerId   String?  // → Customer.id  (walk-in lokal)
  memberId     String?  // → StoreUser.id (member loyalty)
  saleNumber   String
  subtotal     Decimal  @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)
  tax          Decimal  @default(0) @db.Decimal(10, 2)
  ongkir       Decimal  @default(0) @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  pointsEarned Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier        StoreStaff     @relation("CashierSales", fields: [cashierId], references: [id])
  customer       Customer?      @relation(fields: [customerId], references: [id])
  member         StoreUser?     @relation("MemberSales", fields: [memberId], references: [id])
  items          SaleItem[]
  payment        Payment?
  pointHistories PointHistory[]
  cashflow       Cashflow?

  @@unique([storeId, saleNumber])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  variantId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  saleId          String        @unique
  storeId         String
  method          String
  status          PaymentStatus @default(PAID)
  amount          Decimal       @db.Decimal(10, 2)
  midtransOrderId String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// UPGRADE PAYMENT
// ─────────────────────────────────────────────────────────────────────────────

model UpgradePayment {
  id              String        @id @default(cuid())
  storeId         String
  method          String        @default("MIDTRANS")
  status          PaymentStatus @default(PAID)
  amount          Decimal       @db.Decimal(10, 2)
  midtransOrderId String        @unique
  planDays        Int           @default(30)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("upgrade_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// POINT HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model PointHistory {
  id          String      @id @default(cuid())
  storeUserId String
  saleId      String?
  type        PointTxType
  delta       Int
  description String
  createdAt   DateTime    @default(now())

  storeUser StoreUser @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeUserId])
  @@map("point_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// CASHFLOW
// ─────────────────────────────────────────────────────────────────────────────

model Cashflow {
  id          String          @id @default(cuid())
  storeId     String
  saleId      String?         @unique
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(10, 2)
  description String
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeId, occurredAt])
  @@map("cashflows")
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK MOVEMENT
// ─────────────────────────────────────────────────────────────────────────────

model StockMovement {
  id        String       @id @default(cuid())
  variantId String
  storeId   String
  type      MovementType
  quantity  Int
  notes     String?
  refSaleId String?
  createdAt DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE SETTING
// ─────────────────────────────────────────────────────────────────────────────

model StoreSetting {
  id          String   @id @default(cuid())
  storeId     String
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@map("store_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum StaffRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  CASHIER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum MemberTier {
  REGULAR
}

enum Plan {
  FREE
  PRO
}

enum ProductType {
  READY_STOCK
  PREORDER
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGED
}

enum PointTxType {
  EARN
  EARN_MANUAL
  REDEEM
  ADJUST
  EXPIRE
  REGISTER
  UPGRADE
}
