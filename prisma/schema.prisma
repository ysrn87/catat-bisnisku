generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SaaS: Store (tenant) ─────────────────────────────────────────────────────

model Store {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  plan                  Plan      @default(FREE)
  ownerId               String
  logoUrl               String?
  subscriptionExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner          User            @relation("StoreOwner", fields: [ownerId], references: [id])
  members        StoreUser[]
  products       Product[]
  variants       ProductVariant[]
  sales          Sale[]
  customers      Customer[]
  cashflows      Cashflow[]
  settings       Settings[]
  stockMovements StockMovement[]
  categories     Category[]
  pointHistories PointHistory[]
  payments       Payment[]

  @@map("stores")
}

model StoreUser {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(MEMBER)
  createdAt DateTime  @default(now())

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_users")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id               String         @id @default(cuid())
  email            String?        @unique
  password         String
  name             String
  phone            String         @unique(map: "users_phone_unique")
  birthday         DateTime?
  photoUrl         String?
  role             Role           @default(MEMBER)
  points           Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  address          String?

  ownedStores      Store[]        @relation("StoreOwner")
  storeUsers       StoreUser[]
  createdCashflows Cashflow[]
  pointsHistory    PointHistory[]
  createdProducts  Product[]      @relation("CreatedBy")
  updatedProducts  Product[]      @relation("UpdatedBy")
  cashierSales     Sale[]         @relation("CashierSales")
  sales            Sale[]         @relation("CustomerSales")

  @@map("users")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id          String           @id @default(cuid())
  storeId     String
  name        String
  description String?
  sku         String
  type        ProductType      @default(READY_STOCK)
  isActive    Boolean          @default(true)
  categoryId  String?
  createdById String
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  createdBy   User             @relation("CreatedBy", fields: [createdById], references: [id])
  updatedBy   User?            @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([storeId, sku])
  @@map("products")
}

model ProductVariant {
  id             String          @id @default(cuid())
  storeId        String
  productId      String
  name           String
  sku            String
  barcode        String?
  price          Decimal         @db.Decimal(10, 2)
  cost           Decimal         @db.Decimal(10, 2)
  stock          Int             @default(0)
  lowStock       Int             @default(10)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  points         Int             @default(0)

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@map("product_variants")
}


// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  color     String?   // hex color, e.g. "#f08020"
  icon      String?   // emoji atau nama icon, e.g. "🍔"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, name])
  @@map("categories")
}

// ─── Stock ────────────────────────────────────────────────────────────────────

model StockMovement {
  id        String         @id @default(cuid())
  storeId   String
  variantId String
  quantity  Int
  type      String
  notes     String?
  createdAt DateTime       @default(now())

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@map("stock_movements")
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Settings {
  id          String   @id @default(cuid())
  storeId     String
  key         String
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@map("settings")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales     Sale[]   @relation("NonMemberSales")

  @@unique([storeId, phone])
  @@map("customers")
}

// ─── Sale ─────────────────────────────────────────────────────────────────────

model Sale {
  id                  String        @id @default(cuid())
  storeId             String
  saleNumber          String
  customerId          String?
  nonMemberCustomerId String?
  cashierId           String
  subtotal            Decimal       @db.Decimal(10, 2)
  discount            Decimal       @default(0) @db.Decimal(10, 2)
  tax                 Decimal       @default(0) @db.Decimal(10, 2)
  ongkir              Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  paymentMethod       String
  paymentStatus       PaymentStatus @default(PAID)
  notes               String?
  pointsEarned        Int           @default(0)
  pointsRedeemed      Int           @default(0)
  createdAt           DateTime      @default(now())

  store               Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items               SaleItem[]
  cashier             User          @relation("CashierSales", fields: [cashierId], references: [id])
  customer            User?         @relation("CustomerSales", fields: [customerId], references: [id])
  nonMemberCustomer   Customer?     @relation("NonMemberSales", fields: [nonMemberCustomerId], references: [id])

  @@unique([storeId, saleNumber])
  @@map("sales")
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  variantId String
  quantity  Int
  price     Decimal        @db.Decimal(10, 2)
  subtotal  Decimal        @db.Decimal(10, 2)

  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

// ─── Points ───────────────────────────────────────────────────────────────────

model PointHistory {
  id          String    @id @default(cuid())
  userId      String
  storeId     String?
  points      Int
  type        String
  description String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user        User      @relation(fields: [userId], references: [id])
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([userId, storeId])
  @@map("point_history")
}

// ─── Cashflow ─────────────────────────────────────────────────────────────────

model Cashflow {
  id          String          @id @default(cuid())
  storeId     String
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(10, 2)
  description String
  date        DateTime        @default(now())
  createdById String
  createdAt   DateTime        @default(now())

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@map("cashflows")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
}

enum StoreRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  MEMBER
}

enum ProductType {
  READY_STOCK
  PREORDER
}

enum Role {
  ADMINISTRATOR
  MANAGER
  MEMBER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentStatus {
  PAID
  PENDING
  UNPAID
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  storeId     String
  status      String
  grossAmount Decimal  @db.Decimal(10, 2)
  processedAt DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("payments")
}
