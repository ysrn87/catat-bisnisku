generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
//
// Perubahan dari skema lama:
// - Role global DIHAPUS — tidak ada enum Role. Otorisasi 100% dari StoreUser.
// - isSuperAdmin: Boolean — flag internal untuk akses super admin dashboard.
//   Di-set manual di DB, tidak ada UI register untuk ini.
// - address: tetap di User — dipakai lintas konteks (member, non-member,
//   customer, manager, cashier profile) jadi disimpan di sini saja.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  password     String?
  address      String?
  photoUrl     String?
  birthday     DateTime?
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedStores   Store[]        @relation("StoreOwner")
  storeUsers    StoreUser[]
  cashierSales  Sale[]         @relation("CashierSales")
  customerSales Sale[]         @relation("CustomerSales")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE
//
// Perubahan:
// - subscriptionExpiresAt → planExpiresAt (lebih deskriptif)
// - ownerId tetap ada sebagai FK langsung ke User (satu owner, tidak bisa transfer)
// - Payment dipindah ke relasi lewat Sale (bukan langsung dari Store)
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id            String    @id @default(cuid())
  ownerId       String
  name          String
  slug          String    @unique
  logoUrl       String?
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner          User            @relation("StoreOwner", fields: [ownerId], references: [id])
  storeUsers     StoreUser[]
  products       Product[]
  variants       ProductVariant[]
  categories     Category[]
  sales          Sale[]
  cashflows      Cashflow[]
  stockMovements StockMovement[]
  settings       StoreSetting[]
  payments       Payment[]

  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE USER (pivot User ↔ Store)
//
// Perubahan:
// - points dipindah ke sini (sudah ada) — ini tetap sumber kebenaran saldo poin
// - role menggunakan StoreRole enum yang sudah bersih
// - TIDAK ada relasi balik ke User.role global — role global sudah dihapus
// ─────────────────────────────────────────────────────────────────────────────

model StoreUser {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(MEMBER)
  points    Int       @default(0)
  joinedAt  DateTime  @default(now())

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointHistories PointHistory[]

  @@unique([storeId, userId])
  @@map("store_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT
//
// Perubahan:
// - createdById / updatedById dihapus — audit trail ini jarang dipakai dan
//   mempersulit delete user. Kalau perlu, tambah balik nanti.
// - type (READY_STOCK/PREORDER) dipindah ke ProductVariant saja — lebih fleksibel
//   karena satu produk bisa punya varian ready stock dan preorder sekaligus.
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT VARIANT
//
// Perubahan:
// - type (ProductType) ada di sini, bukan di Product
// - pointsPerUnit: Int — berapa poin yang di-earn per unit terjual (0 = tidak earn)
//   Ini menggantikan field `points` yang ada di skema lama
// - lowStockAt menggantikan lowStock (nama lebih deskriptif)
// ─────────────────────────────────────────────────────────────────────────────

model ProductVariant {
  id           String      @id @default(cuid())
  storeId      String
  productId    String
  name         String
  sku          String
  barcode      String?
  price        Decimal     @db.Decimal(10, 2)
  cost         Decimal     @db.Decimal(10, 2)
  type         ProductType @default(READY_STOCK)
  stock        Int         @default(0)
  lowStockAt   Int         @default(10)
  pointsPerUnit Int        @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY
// Tidak ada perubahan signifikan.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  color     String?
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALE
//
// Perubahan:
// - paymentMethod dihapus dari Sale — dipindah ke Payment (karena satu sale
//   bisa punya metode pembayaran berbeda via Midtrans)
// - paymentStatus dihapus — status ada di Payment
// - pointsRedeemed dihapus — sudah tercatat di PointHistory dengan delta negatif
// - ongkir tetap ada (relevan untuk delivery order)
// - notes tetap ada
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id             String    @id @default(cuid())
  storeId        String
  cashierId      String
  customerId     String?
  saleNumber     String
  subtotal       Decimal   @db.Decimal(10, 2)
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  tax            Decimal   @default(0) @db.Decimal(10, 2)
  ongkir         Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  pointsEarned   Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier        User           @relation("CashierSales", fields: [cashierId], references: [id])
  customer       User?          @relation("CustomerSales", fields: [customerId], references: [id])
  items          SaleItem[]
  payment        Payment?
  pointHistories PointHistory[]
  cashflow       Cashflow?

  @@unique([storeId, saleNumber])
  @@map("sales")
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  variantId String
  quantity  Int
  price     Decimal        @db.Decimal(10, 2)
  subtotal  Decimal        @db.Decimal(10, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT (Midtrans)
//
// Perubahan:
// - saleId FK UNIQUE (1 sale = 1 payment record)
// - method: String — CASH, QRIS, TRANSFER, MIDTRANS, dll
// - status: PaymentStatus enum
// - midtransOrderId: String? UNIQUE — diisi hanya untuk transaksi Midtrans
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  saleId          String        @unique
  storeId         String
  method          String        // CASH | QRIS | TRANSFER | MIDTRANS | dll
  status          PaymentStatus @default(PAID)
  amount          Decimal       @db.Decimal(10, 2)
  midtransOrderId String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// POINT HISTORY
//
// Perubahan BESAR:
// - userId + storeId? diganti dengan storeUserId → FK langsung ke StoreUser
//   Ini lebih bersih: satu record point history selalu milik satu StoreUser
//   (kombinasi user + toko), tidak perlu dua FK terpisah.
// - points (bisa positif/negatif) diganti dengan delta (lebih deskriptif)
//   +N = earn, -N = redeem/expire
// - saleId: FK? → Sale — untuk audit trail otomatis dari transaksi
// - type: PointTxType enum (EARN, REDEEM, ADJUST, EXPIRE, REGISTER, UPGRADE)
// - expiresAt dihapus per-history — kalau perlu expiry, kelola di level StoreUser
// ─────────────────────────────────────────────────────────────────────────────

model PointHistory {
  id          String       @id @default(cuid())
  storeUserId String
  saleId      String?
  type        PointTxType
  delta       Int          // positif = earn, negatif = redeem/expire
  description String
  createdAt   DateTime     @default(now())

  storeUser StoreUser @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeUserId])
  @@map("point_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// CASHFLOW
//
// Perubahan:
// - createdById dihapus — sama seperti Product, audit trail ini mempersulit
//   delete user. Ganti dengan saleId (auto) atau manual entry tanpa creator.
// - saleId: FK? UNIQUE → Sale — kalau berasal dari transaksi, 1 sale = 1 cashflow
// - date + time digabung jadi occurredAt: DateTime
// - category tetap String (fleksibel, admin bisa bebas isi)
// ─────────────────────────────────────────────────────────────────────────────

model Cashflow {
  id          String          @id @default(cuid())
  storeId     String
  saleId      String?         @unique
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(10, 2)
  description String
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeId, occurredAt])
  @@map("cashflows")
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK MOVEMENT
//
// Perubahan:
// - storeId dihapus — redundan karena variant sudah punya storeId
// - type: MovementType enum (bukan String bebas)
// - refSaleId: FK? → Sale — untuk audit trail pengurangan stok dari penjualan
// ─────────────────────────────────────────────────────────────────────────────

model StockMovement {
  id         String       @id @default(cuid())
  variantId  String
  storeId    String
  type       MovementType
  quantity   Int          // positif = masuk, negatif = keluar
  notes      String?
  refSaleId  String?
  createdAt  DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE SETTING
//
// Perubahan:
// - Rename dari Settings → StoreSetting (lebih eksplisit)
// - updatedAt ditambah createdAt
// ─────────────────────────────────────────────────────────────────────────────

model StoreSetting {
  id          String   @id @default(cuid())
  storeId     String
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@map("store_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

// StoreRole: role user DI DALAM toko (sumber kebenaran otorisasi)
// Tidak ada enum Role global — sudah dihapus
enum StoreRole {
  OWNER         // pemilik toko, tidak bisa di-assign, tidak bisa ditransfer
  ADMINISTRATOR // kelola semua aspek toko kecuali delete toko
  MANAGER       // kelola produk, stok, laporan, tim bawahnya
  CASHIER       // akses POS saja
  MEMBER        // pelanggan terdaftar, punya poin
  CUSTOMER      // pelanggan dengan akun tapi belum jadi member resmi, tidak punya poin
}

enum Plan {
  FREE
  PRO
}

enum ProductType {
  READY_STOCK
  PREORDER
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED  // tambahan: untuk kasus pembatalan Midtrans
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MovementType {
  PURCHASE    // beli stok masuk
  SALE        // keluar dari penjualan (otomatis)
  ADJUSTMENT  // koreksi manual
  RETURN      // retur dari customer
  DAMAGED     // barang rusak/hilang
}

enum PointTxType {
  EARN        // dapat poin dari transaksi
  EARN_MANUAL // dapat poin dari input manual admin
  REDEEM      // tukar poin
  ADJUST      // koreksi manual
  EXPIRE      // poin hangus
  REGISTER    // poin selamat datang saat jadi member
  UPGRADE     // catatan upgrade dari CUSTOMER ke MEMBER
}
