generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  password     String?
  address      String?
  photoUrl     String?
  birthday     DateTime?
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedStores     Store[]      @relation("StoreOwner")
  staffRecords    StoreStaff[] // relasi ke tabel staff (OWNER/ADMIN/MANAGER/CASHIER)
  storeUsers      StoreUser[]  // relasi ke tabel member
  linkedCustomers Customer[]   // Customer lokal yang sudah di-link ke akun ini

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id            String    @id @default(cuid())
  ownerId       String
  name          String
  slug          String    @unique
  logoUrl       String?
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner          User            @relation("StoreOwner", fields: [ownerId], references: [id])
  staffMembers   StoreStaff[]    // tim operasional toko
  storeUsers     StoreUser[]     // member loyalty toko
  customers      Customer[]      // walk-in customers lokal toko ini
  products       Product[]
  variants       ProductVariant[]
  categories     Category[]
  sales          Sale[]
  cashflows      Cashflow[]
  stockMovements StockMovement[]
  settings       StoreSetting[]
  payments       Payment[]
  upgradePayments UpgradePayment[]

  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE STAFF  (baru — menggantikan StoreUser untuk role operasional)
// Tim in-house: OWNER, ADMINISTRATOR, MANAGER, CASHIER
// Seorang user bisa sekaligus jadi StoreStaff DAN StoreUser (member) di toko
// yang sama — karena dua tabel terpisah dengan unique constraint masing-masing.
// ─────────────────────────────────────────────────────────────────────────────

model StoreStaff {
  id       String    @id @default(cuid())
  storeId  String
  userId   String
  role     StaffRole @default(CASHIER)
  joinedAt DateTime  @default(now())

  store        Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashierSales Sale[] @relation("CashierSales") // sales yang di-proses staff ini

  @@unique([storeId, userId])
  @@map("store_staff")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE USER  (sekarang MURNI untuk member loyalty)
// Hanya role MEMBER — yang punya akun & mengumpulkan poin.
// ─────────────────────────────────────────────────────────────────────────────

model StoreUser {
  id       String   @id @default(cuid())
  storeId  String
  userId   String
  points   Int      @default(0)
  joinedAt DateTime @default(now())

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointHistories PointHistory[]
  memberSales    Sale[]         @relation("MemberSales")

  @@unique([storeId, userId])
  @@map("store_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER  (walk-in / non-member lokal per toko)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String?
  address   String?
  userId    String?  // optional — diisi setelah upgrade ke member

  createdAt DateTime @default(now())

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id])
  sales Sale[]

  @@index([storeId])
  @@index([userId])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  sku         String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@unique([storeId, sku])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT VARIANT
// ─────────────────────────────────────────────────────────────────────────────

model ProductVariant {
  id            String      @id @default(cuid())
  storeId       String
  productId     String
  name          String
  sku           String
  barcode       String?
  price         Decimal     @db.Decimal(10, 2)
  cost          Decimal     @db.Decimal(10, 2)
  type          ProductType @default(READY_STOCK)
  stock         Int         @default(0)
  lowStockAt    Int         @default(10)
  pointsPerUnit Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  color     String?
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALE
// cashierId → StoreStaff.id  (staff yang memproses transaksi)
// memberId  → StoreUser.id   (member loyalty, nullable)
// customerId → Customer.id   (walk-in lokal, nullable)
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id           String    @id @default(cuid())
  storeId      String
  cashierId    String    // → StoreStaff.id
  customerId   String?   // → Customer.id  (walk-in lokal)
  memberId     String?   // → StoreUser.id (member dengan akun)
  saleNumber   String
  subtotal     Decimal   @db.Decimal(10, 2)
  discount     Decimal   @default(0) @db.Decimal(10, 2)
  tax          Decimal   @default(0) @db.Decimal(10, 2)
  ongkir       Decimal   @default(0) @db.Decimal(10, 2)
  total        Decimal   @db.Decimal(10, 2)
  pointsEarned Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier        StoreStaff     @relation("CashierSales", fields: [cashierId], references: [id])
  customer       Customer?      @relation(fields: [customerId], references: [id])
  member         StoreUser?     @relation("MemberSales", fields: [memberId], references: [id])
  items          SaleItem[]
  payment        Payment?
  pointHistories PointHistory[]
  cashflow       Cashflow?

  @@unique([storeId, saleNumber])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  variantId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  saleId          String        @unique
  storeId         String
  method          String
  status          PaymentStatus @default(PAID)
  amount          Decimal       @db.Decimal(10, 2)
  midtransOrderId String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// UPGRADE PAYMENT
// ─────────────────────────────────────────────────────────────────────────────

model UpgradePayment {
  id              String        @id @default(cuid())
  storeId         String
  method          String        @default("MIDTRANS")
  status          PaymentStatus @default(PAID)
  amount          Decimal       @db.Decimal(10, 2)
  midtransOrderId String        @unique
  planDays        Int           @default(30)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("upgrade_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// POINT HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model PointHistory {
  id          String      @id @default(cuid())
  storeUserId String
  saleId      String?
  type        PointTxType
  delta       Int
  description String
  createdAt   DateTime    @default(now())

  storeUser StoreUser @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeUserId])
  @@map("point_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// CASHFLOW
// ─────────────────────────────────────────────────────────────────────────────

model Cashflow {
  id          String          @id @default(cuid())
  storeId     String
  saleId      String?         @unique
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(10, 2)
  description String
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeId, occurredAt])
  @@map("cashflows")
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK MOVEMENT
// ─────────────────────────────────────────────────────────────────────────────

model StockMovement {
  id        String       @id @default(cuid())
  variantId String
  storeId   String
  type      MovementType
  quantity  Int
  notes     String?
  refSaleId String?
  createdAt DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE SETTING
// ─────────────────────────────────────────────────────────────────────────────

model StoreSetting {
  id          String   @id @default(cuid())
  storeId     String
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@map("store_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

// Untuk StoreStaff — tim operasional in-house
enum StaffRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  CASHIER
}

// Untuk StoreUser — hanya member loyalty
// (enum ini bisa dihapus jika StoreUser tidak butuh role field)
// Dipertahankan untuk fleksibilitas jika nanti ada tier member (SILVER, GOLD, dll)
enum MemberTier {
  REGULAR
}

enum Plan {
  FREE
  PRO
}

enum ProductType {
  READY_STOCK
  PREORDER
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGED
}

enum PointTxType {
  EARN
  EARN_MANUAL
  REDEEM
  ADJUST
  EXPIRE
  REGISTER
  UPGRADE
}
